{
  "name": "dsh-sidebar-panels-fold",
  "version": "1.0.0",
  "type": "module",
  "description": "Collapse / filter the sidebar global-panel rows so they stop covering the workspace (mobile + desktop).",
  "license": "MIT",
  "author": "xintingcui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xintingcui/dsh-sidebar-panels-fold.git"
  },
  "homepage": "https://github.com/xintingcui/dsh-sidebar-panels-fold#readme",
  "bugs": {
    "url": "https://github.com/xintingcui/dsh-sidebar-panels-fold/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "layout",
    "ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node smoke-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
